# Environment variables read by infra/params/*.bicepparam and
# infra/scripts/deploy-azure.sh. This file documents the NAMES; it contains no
# values and must stay that way. Real values belong in one of:
#   - infra/.secrets/<env>.env   (git-ignored; create with --generate-secrets)
#   - your shell environment
#   - GitHub Environment secrets (CI)
# and end up in Azure Key Vault. Compare deploy/.env.example, which is the LOCAL
# (docker-compose) equivalent - the two never mix.

# ── secrets: required for every environment ──────────────────────────────────
# Hex-only values are safest; they are embedded in connection strings.
TM_POSTGRES_ADMIN_PASSWORD=
TM_JWT_KEY=                 # HS256 signing key shared by all services, >= 32 bytes
TM_RABBITMQ_PASSWORD=
TM_ADMIN_SEED_PASSWORD=     # password of the seeded Admin user (UserService startup)
TM_GRAFANA_ADMIN_PASSWORD=

# ── settings ─────────────────────────────────────────────────────────────────
TM_ADMIN_EMAIL=             # seeded Admin's email; required for staging and prod
TM_LOCATION=                # Azure region, only needed to create the resource group
TM_IMAGE_TAG=               # set by the script (git SHA); rarely set by hand
TM_DEPLOY_STAGE=            # set by the script: foundation | migrate | apps
