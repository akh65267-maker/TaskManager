# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored - never commit real secrets.
#
# Generate strong random values, e.g.:
#   openssl rand -base64 48   (for JWT_KEY)
#   openssl rand -base64 24   (for passwords)

# Shared Postgres password across the per-service Postgres containers.
POSTGRES_PASSWORD=change-me

# RabbitMQ credentials (used instead of the guest/guest default).
RABBITMQ_USER=taskmanager
RABBITMQ_PASSWORD=change-me

# HMAC-SHA256 signing key shared by every service that issues/validates
# JWTs. Must be at least 32 bytes.
JWT_KEY=change-me-to-a-long-random-string
JWT_ISSUER=TaskManager
JWT_AUDIENCE=TaskManager

# UserService seeds this one admin account on startup if it doesn't
# already exist - there's no invite/promote-user flow yet.
ADMIN_EMAIL=admin@taskmanager.local
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Store Admin
